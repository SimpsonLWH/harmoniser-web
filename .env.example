# MongoDB Atlas connection string (Frankfurt, least-privilege user).
MONGODB_URI="mongodb+srv://user:password@cluster.example.mongodb.net/harmoniser?retryWrites=true&w=majority"

# One secret used for owner-token hashes and rate-limit IP buckets. Generate with:
#   openssl rand -base64 48
APP_HMAC_SECRET="replace-me"

# Exact browser origins allowed to publish, delete, install or report.
# Comma-separated; the deployed site origin and http://localhost:3000 while developing.
ALLOWED_ORIGINS="http://localhost:3000"

# Public base URL of the deployed site (used for metadata, sitemap and robots).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional: label stored on every published capsule (defaults to web-0.1.0).
VALIDATOR_REVISION="web-0.1.0"

# Seed script only: owner token for the example capsules. If unset, the seed generates one and
# prints it once. Keep it if you want to delete the examples later.
SEED_OWNER_TOKEN=""
